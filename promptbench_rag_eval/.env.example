# --- Dify (--provider dify): https://udify.app/chat/4KeH0H4I0KUVfUJ3 is the human chat UI, ---
# not a callable API endpoint. Get an API key from the Dify console (open your app ->
# API Access -> API Key) and put it here instead. Leave DIFY_BASE_URL unset for Dify
# Cloud (defaults to https://api.dify.ai/v1); set it only for a self-hosted Dify instance.
DIFY_API_KEY=
DIFY_BASE_URL=
